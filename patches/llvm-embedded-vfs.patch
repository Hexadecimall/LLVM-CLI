+static IntrusiveRefCntPtr<InMemoryFileSystem> createEmbeddedFileSystem() {
+  static IntrusiveRefCntPtr<InMemoryFileSystem> Memory = [] {
+    auto Enumerate = reinterpret_cast<LLVMEnumerateEmbeddedFilesFn>(
+        dlsym(RTLD_DEFAULT, "LLVMEnumerateEmbeddedFiles"));
+    if (!Enumerate)
+      return IntrusiveRefCntPtr<InMemoryFileSystem>();
+    auto FS = makeIntrusiveRefCnt<InMemoryFileSystem>();
+    auto AddFile = [](const char *Path, const void *Data, std::size_t Size,
+                      void *Context) {
+      auto *FS = static_cast<InMemoryFileSystem *>(Context);
+      FS->addFile(Path, 0,
+                  MemoryBuffer::getMemBufferCopy(
+                      StringRef(static_cast<const char *>(Data), Size), Path));
+    };
+    Enumerate(AddFile, FS.get());
+    return FS;
+  }();
+  return Memory;
+}
+
 IntrusiveRefCntPtr<FileSystem> vfs::getRealFileSystem() {
-  static IntrusiveRefCntPtr<FileSystem> FS =
-      makeIntrusiveRefCnt<RealFileSystem>(true);
+  static IntrusiveRefCntPtr<FileSystem> FS = [] {
+    IntrusiveRefCntPtr<FileSystem> Physical =
+        makeIntrusiveRefCnt<RealFileSystem>(true);
+    auto Memory = createEmbeddedFileSystem();
+    if (!Memory)
+      return Physical;
+    auto Overlay = makeIntrusiveRefCnt<OverlayFileSystem>(Physical);
+    Overlay->pushOverlay(Memory);
+    return IntrusiveRefCntPtr<FileSystem>(std::move(Overlay));
+  }();
   sys::sandbox::violationIfEnabled();
 
   return FS;
