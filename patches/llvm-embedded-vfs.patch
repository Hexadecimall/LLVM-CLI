 std::unique_ptr<FileSystem> vfs::createPhysicalFileSystem() {
   sys::sandbox::violationIfEnabled();
 
+  if (auto Memory = createEmbeddedFileSystem()) {
+    auto Physical = makeIntrusiveRefCnt<RealFileSystem>(false);
+    auto Overlay = std::make_unique<OverlayFileSystem>(Physical);
+    Overlay->pushOverlay(Memory);
+    return Overlay;
+  }
   return std::make_unique<RealFileSystem>(false);
 }
 
