--- a/llvm/cmake/modules/FindLibEdit.cmake
+++ b/llvm/cmake/modules/FindLibEdit.cmake
@@ -18,6 +18,18 @@
 
 find_path(LibEdit_INCLUDE_DIRS NAMES histedit.h HINTS ${PC_LIBEDIT_INCLUDE_DIRS})
 find_library(LibEdit_LIBRARIES NAMES edit HINTS ${PC_LIBEDIT_LIBRARY_DIRS})
+if(LibEdit_LIBRARIES MATCHES "\\.a$")
+  set(_LibEdit_saved_suffixes "${CMAKE_FIND_LIBRARY_SUFFIXES}")
+  set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
+  find_library(LibEdit_TERMCAP_LIBRARY NAMES ncursesw ncurses curses tinfo)
+  set(CMAKE_FIND_LIBRARY_SUFFIXES "${_LibEdit_saved_suffixes}")
+  unset(_LibEdit_saved_suffixes)
+  if(NOT LibEdit_TERMCAP_LIBRARY)
+    message(FATAL_ERROR "Static libedit needs a static termcap library; set LibEdit_TERMCAP_LIBRARY")
+  endif()
+  list(APPEND LibEdit_LIBRARIES "${LibEdit_TERMCAP_LIBRARY}")
+endif()
+
 
 include(CheckIncludeFile)
 if(LibEdit_INCLUDE_DIRS AND EXISTS "${LibEdit_INCLUDE_DIRS}/histedit.h")
