# One native source/configuration, static libraries, and an optimized multicall core.
set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_LLVM_DYLIB OFF CACHE BOOL "" FORCE)
set(LLVM_LINK_LLVM_DYLIB OFF CACHE BOOL "" FORCE)
set(LLVM_TOOL_LLVM_DRIVER_BUILD ON CACHE BOOL "" FORCE)
set(LLVM_ENABLE_PROJECTS "clang;clang-tools-extra;lld;lldb;flang;mlir;polly;bolt" CACHE STRING "" FORCE)
set(LLVM_TARGETS_TO_BUILD all CACHE STRING "" FORCE)
set(LLVM_EXPERIMENTAL_TARGETS_TO_BUILD all CACHE STRING "" FORCE)
set(LLVM_ENABLE_LTO Thin CACHE STRING "" FORCE)
set(LLVM_ENABLE_ASSERTIONS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_BINDINGS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_DOCS OFF CACHE BOOL "" FORCE)
set(LLVM_BUILD_TOOLS ON CACHE BOOL "" FORCE)
set(LLVM_BUILD_UTILS ON CACHE BOOL "" FORCE)
set(LLVM_ENABLE_RTTI ON CACHE BOOL "" FORCE)
set(LLVM_ENABLE_EH OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_MODULES OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_ZLIB FORCE_ON CACHE STRING "" FORCE)
set(LLVM_ENABLE_ZSTD FORCE_ON CACHE STRING "" FORCE)
set(LLVM_USE_STATIC_ZSTD ON CACHE BOOL "" FORCE)
set(LLVM_ENABLE_LIBXML2 FORCE_ON CACHE STRING "" FORCE)
set(CLANG_LINK_CLANG_DYLIB OFF CACHE BOOL "" FORCE)
set(LIBCLANG_BUILD_STATIC ON CACHE BOOL "" FORCE)
set(LLDB_ENABLE_PYTHON ON CACHE STRING "" FORCE)
set(LLDB_ENABLE_LUA ON CACHE STRING "" FORCE)
set(LLDB_ENABLE_DYNAMIC_SCRIPTINTERPRETERS OFF CACHE BOOL "" FORCE)
set(LLDB_ENABLE_LIBEDIT ON CACHE STRING "" FORCE)
set(LLDB_ENABLE_CURSES ON CACHE STRING "" FORCE)
set(LLDB_ENABLE_LZMA ON CACHE STRING "" FORCE)
set(LLDB_ENABLE_LIBXML2 ON CACHE STRING "" FORCE)
set(LLDB_BUILD_FRAMEWORK OFF CACHE BOOL "" FORCE)
set(LLDB_NO_INSTALL_DEFAULT_RPATH ON CACHE BOOL "" FORCE)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "" FORCE)
